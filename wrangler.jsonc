{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "public-agents",
  "main": "worker/index.ts",
  "compatibility_date": "2026-09-01",
  "workers_dev": false,
  "observability": { "enabled": true },
  "assets": {
    "directory": "site/dist",
    "binding": "ASSETS",
    "not_found_handling": "404-page",
    "html_handling": "drop-trailing-slash",
    // Only the paths that need logic run the Worker; every other file is
    // served straight from the assets.
    "run_worker_first": ["/", "/@*", "/agents", "/agents/*", "/tools", "/tools/*", "/jobs", "/jobs/*", "/functions/*", "/evidence/*", "/search", "/register", "/contributing", "/about", "/schemas", "/.well-known/api-catalog"]
  },
  "routes": [
    { "pattern": "public-agents.com", "custom_domain": true },
    { "pattern": "www.public-agents.com", "custom_domain": true }
  ]
}
