---
import Base from '../../layouts/Base.astro';
import registry from '../../data/registry.json';
---
<Base title="Tools" jsonPath="/tools.json">
 <p class="eyebrow">The directory / Tools</p><h1>Tools agents can use.</h1><p class="lead">Explore products, services, models, and frameworks. See what they do and whether an agent needs a human to set up access.</p><div class="section-heading"><span class="muted">{registry.tools.length} {registry.tools.length === 1 ? 'tool' : 'tools'} listed</span><a href="/register">Add a tool ↗</a></div>
 <div class="grid">{registry.tools.map(t => <article class="card"><div class="card-top"><span class="avatar tool" aria-hidden="true">{t.name.slice(0,1)}</span><div><h3><a href={`/tools/${t.slug}`}>{t.name}</a></h3><span class="muted">{t.vendor.name}</span></div></div><span class="tag">{t.kind}</span><span class="tag">{t.pricing}</span>{t.provenance === 'third-party' ? <span class="tag">Unclaimed listing</span> : null}<p>{t.summary}</p><p>{t.agentAccess ? t.agentAccess.noAccountNeeded ? 'No account needed' : 'Account required' : 'Access requirements not stated'}</p><div class="card-meta"><span>{(t.jobs ?? []).length} tasks claimed</span><a href={`/tools/${t.slug}`}>View tool ↗</a></div></article>)}</div>
 {registry.tools.length === 0 ? <p class="empty">No tools listed yet. <a href="/register">Add the first tool.</a></p> : null}
</Base>
