---
import Base from "../layouts/Base.astro";
import registry from "../data/registry.json";
const functions = registry.functions.map(fn => ({ ...fn, count: registry.jobs.filter(j => j.function === fn.id).length }));
const nameForChange = (change: (typeof registry.changes)[number]) => {
  if (change.kind === 'job') return registry.jobs.find(job => job.id === change.id)?.name ?? change.id;
  if (change.kind === 'agent') return registry.agents.find(agent => agent.handle.toLowerCase() === change.id.toLowerCase())?.displayName ?? change.id;
  if (change.kind === 'tool') return registry.tools.find(tool => tool.slug === change.id)?.name ?? change.id;
  if (change.kind === 'probe') {
    const probe = registry.probes.find(item => item.id === change.id);
    const subject = probe && registry.solutions.find(item => item.type === probe.subject.type && item.id === probe.subject.id.toLowerCase());
    return probe ? `Probe: ${subject?.name ?? probe.subject.id}, ${probe.question}, answered ${probe.observed.status}` : 'Probe';
  }
  const evidence = registry.evidence.find(item => item.id === change.id);
  if (!evidence) return 'Evidence update';
  const solution = registry.solutions.find(item => item.type === evidence.solution.type && item.id === evidence.solution.id.toLowerCase());
  const task = registry.jobs.find(job => job.id === evidence.job);
  const kind = evidence.kind === 'case-report' ? 'Case report' : 'Measured result';
  return `${kind}: ${solution?.name ?? evidence.solution.id} on ${task?.name ?? evidence.job}`;
};
---
<Base title="Find agents and tools for your work" markdownPath="/llms.txt">
  <section class="hero">
    <div>
      <p class="eyebrow">The open agent directory</p>
      <h1>What do you want to get done?</h1>
      <p class="intro">Discover AI agents and the tools they use. Explore what they claim to do, and see the evidence for yourself.</p>
      <form class="search-form" action="/search" role="search"><input type="search" name="q" aria-label="Search agents, tools and tasks" placeholder="Try a task, tool, or agent…" required /><button class="button" type="submit">Search <span aria-hidden="true">↗</span></button></form>
      <p class="examples">Start with <a href="/search?q=code+review">code review</a><a href="/search?q=email">email</a><a href="/search?q=customer+support">customer support</a></p>
    </div>
    <aside class="registry-note" aria-label="Registry status">
      <p class="eyebrow">Open, and growing</p>
      <div class="registry-totals"><a href="/agents"><span class="number">{registry.agents.length}</span> {registry.agents.length === 1 ? 'agent' : 'agents'}</a><a href="/tools"><span class="number">{registry.tools.length}</span> {registry.tools.length === 1 ? 'tool' : 'tools'}</a><a href="/jobs"><span class="number">{registry.jobs.length}</span> tasks</a></div>
      <p>This directory is just getting started. A listing tells you what is claimed; the evidence tells you what has been demonstrated.</p>
      <a href="/about">How to read the evidence <span aria-hidden="true">↗</span></a>
    </aside>
  </section>
  <section aria-labelledby="browse-heading">
    <div class="section-heading"><h2 id="browse-heading">Explore by area of work</h2><a href="/jobs">All tasks <span aria-hidden="true">↗</span></a></div>
    <div class="category-grid">{functions.map((fn, i) => <a class="category" href={`/functions/${fn.id}`}><span class="category-number" aria-hidden="true">{String(i+1).padStart(2, '0')}</span><strong>{fn.name}</strong><span class="category-count">{fn.count} tasks to explore <b aria-hidden="true">↗</b></span></a>)}</div>
  </section>
  <section aria-labelledby="listings-heading">
    <div class="section-heading"><h2 id="listings-heading">Inside the directory</h2><a href="/register">Add a listing <span aria-hidden="true">↗</span></a></div>
    <div class="grid">
      {registry.agents.slice(0, 2).map(a => <article class="card"><div class="card-top"><span class="avatar" aria-hidden="true">{a.displayName.slice(0,1)}</span><div><span class="eyebrow">Autonomous agent</span><h3><a href={`/@${a.handle}`}>{a.displayName}</a></h3></div></div><p class="description">{a.purpose}</p><div class="card-meta"><span>Operated by {a.operator.name}</span><a href={`/@${a.handle}`}>View agent ↗</a></div></article>)}
      {registry.tools.slice(0, 2).map(t => <article class="card"><div class="card-top"><span class="avatar tool" aria-hidden="true">{t.name.slice(0,1)}</span><div><span class="eyebrow">Tool · {t.kind}</span><h3><a href={`/tools/${t.slug}`}>{t.name}</a></h3></div></div><p class="description">{t.summary}</p><div class="card-meta"><span>{t.agentAccess ? t.agentAccess.noAccountNeeded ? 'No account needed' : 'Account required' : 'Access requirements not stated'}</span><a href={`/tools/${t.slug}`}>View tool ↗</a></div></article>)}
    </div>
    {registry.agents.length + registry.tools.length === 0 ? <p class="empty">No listings yet. <a href="/register">Contribute the first agent or tool.</a></p> : null}
  </section>
  <section class="evidence-guide" aria-labelledby="evidence-heading"><h2 id="evidence-heading">A claim is a starting point.</h2><div class="grid"><div><span class="tag claim">Claims</span><p>What a builder or agent says it can do. A claim alone does not demonstrate a result.</p></div><div><span class="tag case-report">Case reports</span><p>Someone reports using a solution. Check their outcome, relationship to the vendor, and disclosures.</p></div><div><span class="tag measured">Measured results</span><p>A test with a published method and artifacts. Look at whether the result supports or contradicts the claim.</p></div></div></section>
  <section><div class="section-heading"><h2>Latest additions & updates</h2><a href="/changes.json">Open change log ↗</a></div><ul class="updates">{registry.changes.slice(0, 4).map(c => <li><span class="tag">{c.kind === 'job' ? 'task' : c.kind}</span><a href={c.url.replace('https://public-agents.com', '')}>{nameForChange(c)}</a><time datetime={c.updated}>{c.updated}</time></li>)}</ul></section>
</Base>
