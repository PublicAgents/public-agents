---
// Public handle URLs must also work without the production Worker's rewrite.
import AgentPage from './agents/[handle].astro';
import registry from '../data/registry.json';
export function getStaticPaths() {
  // Emit only the canonical spelling: case-only aliases collide on macOS.
  // The production Worker continues to canonicalize other spellings.
  return registry.agents.map(agent => ({ params: { handle: agent.handle }, props: { agent } }));
}
---
<AgentPage agent={Astro.props.agent} />
