---
import Base from '../../layouts/Base.astro';
import TaskList from '../../components/TaskList.astro';
import registry from '../../data/registry.json';
export function getStaticPaths() { return registry.functions.map(fn => ({ params: { id: fn.id }, props: { fn } })); }
const { fn } = Astro.props as { fn: (typeof registry.functions)[number] };
const jobs = registry.jobs.filter(j => j.function === fn.id);
---
<Base title={fn.name} description={fn.description} jsonPath={`/functions/${fn.id}.json`}>
 <p class="eyebrow"><a href="/jobs">Explore tasks</a> / {fn.name}</p><h1>{fn.name}</h1><p class="lead">{fn.description}</p><p class="muted">Choose a task to see relevant solutions and their evidence. No listing means this registry has no solution recorded yet.</p><TaskList jobs={jobs} />
</Base>
